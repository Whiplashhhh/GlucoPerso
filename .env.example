# ─────────────────────────────────────────────────────────────
# GlucoPerso configuration. Copy to `.env` (or run `npm run setup`,
# which also generates the secrets for you).
# Never commit the real `.env`.
# ─────────────────────────────────────────────────────────────

# PostgreSQL connection string (dev: `npm run db:up` starts one on port 5433).
DATABASE_URL="postgresql://glucoperso:glucoperso@localhost:5433/glucoperso"

# Public URL of the app, exactly as typed in the browser (https in production).
BETTER_AUTH_URL="http://localhost:3000"

# Secret used to sign sessions (32+ random characters).
# Generated automatically by `npm run setup` and by the Docker entrypoint.
BETTER_AUTH_SECRET=""

# Who can create an account: invite (default, needs an invite code),
# open (anyone, for local tests only) or closed (nobody).
REGISTRATION_MODE="invite"

# Where photos are stored. Must NOT be inside public/.
PHOTOS_DIR="./data/photos"

# Comma-separated reverse-proxy IPs/CIDRs whose X-Forwarded-For can be trusted
# (for rate limiting). Leave empty when not behind a proxy.
TRUSTED_PROXIES=""

# Optional: SMTP for password reset by email. Leave SMTP_HOST empty to disable
# (recovery codes always work).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_FROM="GlucoPerso <noreply@example.org>"

# ─────────────────────────────────────────────────────────────
# Docker production stack only (docker-compose.yml, docs/deploiement.md).
# DATABASE_URL and PHOTOS_DIR above are ignored there: Compose builds them.
# BETTER_AUTH_SECRET may stay empty: the container generates it on first start
# and keeps it in its data volume (/data/secrets.env).
# ─────────────────────────────────────────────────────────────

# Database password (letters and digits only, e.g. `openssl rand -hex 32`).
POSTGRES_PASSWORD=""

# Where the app port is published on the host (keep 127.0.0.1 behind a proxy).
APP_BIND="127.0.0.1"
APP_PORT="3000"

# Bundled Caddy (`docker compose --profile caddy up -d`): public domain name
# and e-mail for Let's Encrypt.
DOMAIN="glucoperso.example.org"
ACME_EMAIL=""
